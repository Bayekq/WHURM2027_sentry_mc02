{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug (ST-Link + OpenOCD)",
      "type": "cortex-debug",
      "request": "launch",
      "servertype": "openocd",
      "cwd": "${workspaceFolder}",
      "executable": "${workspaceFolder}/build/LuojiaFox_H7_Template.elf",
      "device": "STM32H723VG",
      "configFiles": [
        "interface/stlink.cfg",
        "target/stm32h7x.cfg"
      ],
      "runToEntryPoint": "main"
    }
  ]
}
